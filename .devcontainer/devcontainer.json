{
  "name": "Sistema bancario académico",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "shutdownAction": "stopCompose",
  "remoteUser": "node",
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb"
  },
  "forwardPorts": [4200, 3000],
  "portsAttributes": {
    "4200": {
      "label": "Sistema bancario (frontend Angular)",
      "onAutoForward": "openBrowser"
    },
    "3000": {
      "label": "API del sistema bancario (backend)",
      "onAutoForward": "silent"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/estado.sh",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    },
    "vscode": {
      "extensions": [
        "angular.ng-template",
        "cweijan.vscode-mysql-client2"
      ]
    }
  }
}
